# Bootstrap secrets di Infisical stesso — non migrabili su Infisical per
# definizione (dipendenza circolare: sono quello che fa partire Infisical). Vedi
# ADR-007 per la spiegazione completa e per come vengono generati.
ENCRYPTION_KEY=
AUTH_SECRET=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_CONNECTION_URI=

REDIS_URL=

# Deve essere l'URL pubblico reale (es. https://env.tuodominio.it), non l'IP
# interno: usato da Infisical per generare redirect/link, un valore sbagliato
# rompe silenziosamente il flusso di login via CORS. Vedi ADR-007.
SITE_URL=

# SMTP non configurato in questa istanza (nessun invio email da Infisical:
# niente inviti via email, reset password self-service). Limite noto, vedi
# ADR-007. Lasciare vuoto se non serve.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

ENFORCE_ORG_AUTH_SELECTION=

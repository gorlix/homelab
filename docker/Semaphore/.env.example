# Valori reali su Infisical, progetto "Homelab Env", ambiente prod, cartella
# /Semaphore. Materializzati a mano su pve-management (vedi commento in
# docker-compose.yml sul perché non passa dal deploy Ansible automatico):
#
#   infisical export --path=/Semaphore --env=prod --format=dotenv \
#     --token=<token identità ansible-automation> --domain=<...>/api \
#     --projectId=578016f6-4dc0-4507-a961-4d1e84c9be17 > .env
#
SEMAPHORE_ADMIN_PASSWORD=

# Segreto condiviso con il runner remoto registrato (SEMAPHORE_USE_REMOTE_RUNNER):
# se lo ruoti qui, va aggiornato anche lato runner o la pairing si rompe.
SEMAPHORE_RUNNER_REGISTRATION_TOKEN=

# Token dell'app Gotify (gotrify.alessandrogorla.it) usata per gli alert: se lo
# ruoti qui, va rigenerato anche lato Gotify.
SEMAPHORE_GOTIFY_TOKEN=
